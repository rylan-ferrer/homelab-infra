all:
  children:
    control_plane:
      hosts:
        k3s-cp-1:
          ansible_host: ENTER IP ADDRESS 
        k3s-cp-2:
          ansible_host: ENTER IP ADDRESS 
        k3s-cp-3:
          ansible_host: ENTER IP ADDRESS 
    workers:
      hosts:
        k3s-worker-1:
          ansible_host: ENTER IP ADDRESS 
        k3s-worker-2:
          ansible_host: ENTER IP ADDRESS 
        k3s-worker-3:
          ansible_host: ENTER IP ADDRESS 
        k3s-worker-4:
          ansible_host: ENTER IP ADDRESS 
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    